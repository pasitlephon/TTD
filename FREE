--// ดักการเรียก Act (outgoing) พร้อมผลตอบกลับจากเซิร์ฟเวอร์ (incoming)
local IGNORE_ACTIONS = {again = true, next = true, start = true} -- คำสั่งเหล่านี้ไม่เก็บลงมาโคร
local lastT, lastKey = -1, ""

local function shouldWatch()
    return alive()
end

local function beginCall(args)
    local now = os.clock()
    local ok, key = pcall(HttpService.JSONEncode, HttpService, args)
    if not ok then return nil end
    -- กันซ้ำจากการ hook สองชั้น
    if key == lastKey and (now - lastT) < 0.05 then return nil end
    lastT, lastKey = now, key
    return {t = now - recStart, args = args}
end

local function finishCall(entry, results)
    local res = results[1]
    local okRes = type(res) == "table" and res.ok == true
    local action = entry.args[1]

    -- again / next / start: ไม่เก็บลงมาโคร
    if IGNORE_ACTIONS[action] then return end

    -- จำไอดียูนิตที่วางสำเร็จ (ไว้ใช้ Sell All) / ลบเมื่อขาย
    if okRes and action == "place" and res.id then placedIds[res.id] = true end
    if okRes and action == "sell" then placedIds[entry.args[2]] = nil end

    if not recording then return end
    if not okRes then
        print("[Macro] ข้าม (เซิร์ฟเวอร์ไม่ตอบ ok):", describe(entry.args))
        pcall(setStatus, "🔴 กำลังบันทึก  (" .. #recData .. " actions)",
            "ข้าม (ถูกปฏิเสธ): " .. describe(entry.args), nil)
        return
    end
    entry.id = res.id -- ไอดียูนิตที่เซิร์ฟเวอร์ตอบกลับมา (เฉพาะ place)
    table.insert(recData, entry)
    print(string.format("[Macro] recorded #%d: %s%s", #recData, describe(entry.args),
        entry.id and (" -> id " .. tostring(entry.id)) or ""))
    pcall(setStatus, "🔴 กำลังบันทึก  (" .. #recData .. " actions)",
        "ล่าสุด: " .. describe(entry.args) .. (entry.id and ("  [id " .. tostring(entry.id) .. "]") or ""), nil)
end

--// hook ชั้นที่ 1: __namecall (Act:InvokeServer(...))
local oldNC
oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "InvokeServer" and shouldWatch() and isAct(self) and not checkcaller() then
        local entry = beginCall({...})
        pcall(setnamecallmethod, method)
        if entry then
            local results = table.pack(oldNC(self, ...))
            finishCall(entry, results)
            return table.unpack(results, 1, results.n)
        end
    end
    return oldNC(self, ...)
end))

--// hook ชั้นที่ 2: ฟังก์ชันตรงๆ (InvokeServer(Act, ...))
pcall(function()
    local tmp = Instance.new("RemoteFunction")
    local oldInv
    oldInv = hookfunction(tmp.InvokeServer, newcclosure(function(self, ...)
        if shouldWatch() and isAct(self) and not checkcaller() then
            local entry = beginCall({...})
            if entry then
                local results = table.pack(oldInv(self, ...))
                finishCall(entry, results)
                return table.unpack(results, 1, results.n)
            end
        end
        return oldInv(self, ...)
    end))
end)

