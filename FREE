-- ตำแหน่งจุดบนเส้นทางที่มีอยู่จริงตอนนี้ (ว่าง = RouteArrows หายไป/ยังไม่ถูกสร้าง)
local function livePoints()
    local pts = {}
    for _, a in ipairs(routeArrows()) do
        local p = instancePos(a)
        if p then pts[#pts + 1] = p end
    end
    return pts
end

-- จำเส้นทางล่าสุดที่เคยเห็น: ถ้า RouteArrows หาย Auto Tower Placement จะใช้วงเดิมที่จำไว้ต่อ
local routeCache = nil
local usingCache = false

-- คืน (ตำแหน่งบนเส้นทางที่ pct %, จำนวนจุดทั้งหมด) 0% = จุดแรก (ใกล้ฐาน) / 100% = จุดสุดท้าย
-- คำนวณตามความยาวเส้นทางจริง / ถ้าไม่มีทั้งของจริงและที่จำไว้ คืน nil, 0
local liveCache, liveCacheT = {}, -1
local function livePointsCached()
    -- ไม่ต้องไล่อ่าน RouteArrows ทุกครั้งที่วาง (ลดงานต่อรอบ) รีเฟรชทุก 0.3 วิ
    local now = os.clock()
    if now - liveCacheT > 0.3 then
        liveCache, liveCacheT = livePoints(), now
    end
    return liveCache
end

local function getRoutePoint(pct)
    local pts = livePointsCached()
    if #pts > 0 then
        routeCache = pts
        if usingCache then
            usingCache = false
            print("[Macro] พบ RouteArrows อีกครั้ง ใช้เส้นทางจริง")
        end
    elseif routeCache then
        pts = routeCache
        if not usingCache then
            usingCache = true
            print("[Macro] RouteArrows หายไป ใช้วงที่จำไว้ล่าสุดแทน")
        end
    else
        return nil, 0
    end
    local n = #pts
    if n == 1 then return pts[1], 1 end
    local cum, total = {0}, 0
    for i = 2, n do
        total += (pts[i] - pts[i - 1]).Magnitude
        cum[i] = total
    end
    if total <= 0 then return pts[1], n end
    local target = math.clamp(pct, 0, 100) / 100 * total
    for i = 2, n do
        if target <= cum[i] then
            local seg = cum[i] - cum[i - 1]
            local f = seg > 0 and (target - cum[i - 1]) / seg or 0
            return pts[i - 1]:Lerp(pts[i], f), n
        end
    end
    return pts[n], n
end

-- คอยอัปเดตที่จำไว้เบื้องหลังตลอด (เผื่อ RouteArrows หายระหว่างเล่น)
task.spawn(function()
