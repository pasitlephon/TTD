end)

-- ตำแหน่งสำรอง: ถ้าวางที่จุดเดิมไม่ได้ จะขยับหาจุดใกล้เคียง (วงแหวนรอบจุดเดิม)
local PLACE_STEP = 2 -- studs ต่อวงแหวน
local PLACE_OFFSETS = {Vector2.new(0, 0)}
for ring = 1, 3 do
    for i = 0, 7 do
        local ang = i * math.pi / 4
        table.insert(PLACE_OFFSETS, Vector2.new(math.cos(ang) * ring * PLACE_STEP, math.sin(ang) * ring * PLACE_STEP))
    end
end

--// เล่นมาโคร (ทำทีละขั้นตามลำดับ ขั้นไหนไม่สำเร็จจะลองซ้ำจนกว่าจะสำเร็จ ไม่ข้าม)
local setPlayToggle
local RETRY_DELAY = 0.5        -- เว้นกี่วินาทีก่อนลองใหม่
local PLACE_RETRY_DELAY = 0.04 -- Auto Placement: เว้นก่อนลองจุดสำรองถัดไป
local PLACE_SWEEP_DELAY = 0.25 -- Auto Placement: เว้นหลังลองครบทุกจุดแล้วยังไม่ติด
local USE_RECORDED_DELAY = false -- false = ทำขั้นต่อไปทันที / true = เว้นระยะห่างตามที่อัดไว้

local function playMacro(data)
    playToken += 1
    local myToken = playToken
    playing = true
    local total = #data

    local idMap = {} -- id ที่อัดไว้ -> id ใหม่ในแมตช์นี้
    placedIds = {} -- เริ่มแมตช์ใหม่
    local prevT = 0

    -- Auto Tower Placement: หาจุดกึ่งกลาง และระยะไกลสุดจากจุดกึ่งกลางของตำแหน่ง place ที่อัดไว้
    local anchor, maxDist
    if autoPlace then
        local sx, sz, n = 0, 0, 0
        for _, a in ipairs(data) do
            if a.args[1] == "place" and type(a.args[3]) == "number" and type(a.args[4]) == "number" then
                sx += a.args[3]
                sz += a.args[4]
                n += 1
            end
        end
        if n > 0 then
            anchor = Vector2.new(sx / n, sz / n)
            maxDist = 0
            for _, a in ipairs(data) do
                if a.args[1] == "place" and type(a.args[3]) == "number" and type(a.args[4]) == "number" then
                    maxDist = math.max(maxDist, (Vector2.new(a.args[3], a.args[4]) - anchor).Magnitude)
                end
            end
        end
    end
    local warnedNoRoute = false

    -- รอให้เส้นทางจริงโหลดก่อนเริ่มวาง (สูงสุด 8 วิ) ถ้าไม่ขึ้นใช้วงที่จำไว้ล่าสุด
    if autoPlace and anchor then
        local untilT = os.clock() + 2
        while playToken == myToken and #livePoints() == 0 and os.clock() < untilT do
            setStatus("⏳ รอ RouteArrows", "รอเส้นทางมอนสเตอร์โหลดก่อนเริ่มวาง...", nil)
            task.wait(0.1)
        end
        if playToken ~= myToken then return end
        if #livePoints() == 0 then
            if routeCache then
                notify("ไม่พบ RouteArrows ใช้วงที่จำไว้ล่าสุด")
            else
                debugRoute()
            end
        end
    end

    for idx, a in ipairs(data) do
        local args = table.clone(a.args)
        if UNIT_ID_ACTIONS[args[1]] and idMap[args[2]] then
            args[2] = idMap[args[2]]
        end
        local desc = describe(args)

        -- เว้นระยะห่างจากขั้นก่อนหน้าตามที่อัดไว้
        if USE_RECORDED_DELAY then
            local readyAt = os.clock() + math.max(a.t - prevT, 0)
            while playToken == myToken and os.clock() < readyAt do
                setStatus(
                    string.format("▶ ขั้นที่ %d/%d", idx, total),
                    "ถัดไป: " .. desc,
                    (idx - 1) / total
                )
                task.wait()
            end
        end

        -- ลองซ้ำจนกว่าจะสำเร็จ (หยุดได้โดยปิดสวิตช์ Play Macro)
        local try = 0
        while true do
            if playToken ~= myToken then return end
            try += 1

            -- Auto Tower Placement: ย้ายตำแหน่งวางไปรอบจุดที่เลือกบนเส้นทาง
            if autoPlace and anchor and a.args[1] == "place" then
                local pt = getRoutePoint(placePct)
                if pt then
                    -- ลองต่อเนื่อง: ครั้งแรก = จุดหลัก, ครั้งถัดไป = ไล่จุดสำรองจากใกล้ไปไกล (ไม่สลับกลับจุดหลักซ้ำๆ)
                    local off = PLACE_OFFSETS[((try - 1) % #PLACE_OFFSETS) + 1]
                    -- ย่อ/ขยายรูปการวางให้ยูนิตที่ไกลสุดอยู่ที่ขอบวงรัศมี placeRadius
                    local scale = (maxDist and maxDist > 0.01) and (placeRadius / maxDist) or 1
                    args[3] = pt.X + (a.args[3] - anchor.X) * scale + off.X
                    args[4] = pt.Z + (a.args[4] - anchor.Y) * scale + off.Y
                    desc = describe(args)
                elseif not warnedNoRoute then
                    warnedNoRoute = true
                    notify("ไม่พบ RouteArrows ใช้ตำแหน่งเดิมที่อัดไว้")
                end
            end

            setStatus(
                string.format("▶ ขั้นที่ %d/%d%s", idx, total, try > 1 and ("  (ลองครั้งที่ " .. try .. ")") or ""),
                "กำลังทำ: " .. desc,
                (idx - 1) / total
            )

            local reason = "ไม่พบ MatchRemotes.Act"
            local act = getAct()
            if act then
                local ok, res = pcall(function() return act:InvokeServer(table.unpack(args, 1, #args)) end)
                if ok and (type(res) ~= "table" or res.ok ~= false) then
                    if a.id and type(res) == "table" and res.id then
                        idMap[a.id] = res.id
                    end
                    if args[1] == "place" and type(res) == "table" and res.id then placedIds[res.id] = true end
                    print(string.format("[Macro] step %d/%d OK: %s%s", idx, total, desc,
                        (type(res) == "table" and res.id) and (" -> id " .. tostring(res.id)) or ""))
                    break
                end
                if not ok then
                    reason = tostring(res)
                elseif type(res) == "table" then
                    reason = tostring(res.err or res.error or res.reason or res.message or "ok = false")
                end
            end

            setStatus(
                string.format("⏳ ขั้นที่ %d/%d ยังไม่สำเร็จ (ครั้งที่ %d)", idx, total, try),
                desc .. " | " .. reason,
                (idx - 1) / total
            )
            if autoPlace and anchor and a.args[1] == "place" then
                -- วางไม่ติด: ลองจุดถัดไปแทบทันที / ครบทุกจุดแล้วค่อยพักสั้นๆ (กันกรณีเงินไม่พอ)
                task.wait((try % #PLACE_OFFSETS == 0) and PLACE_SWEEP_DELAY or PLACE_RETRY_DELAY)
            else
                task.wait(RETRY_DELAY)
            end
        end

        prevT = a.t
        setStatus(string.format("✔ ขั้นที่ %d/%d สำเร็จ", idx, total), desc, idx / total)
    end

    if playToken == myToken then
        playing = false
        -- จบแล้ว: ปุ่ม Play ยังเปิดค้างไว้ (ไม่ปิดเอง) และจะเริ่มใหม่เมื่อ ReturnToHub ขึ้นบนจอ
        setStatus("✅ เล่นจบแล้ว", "รอ GUI ReturnToHub ขึ้นบนจอ เพื่อเล่นใหม่", 1)
        notify("มาโครจบแล้ว")
    end
end

