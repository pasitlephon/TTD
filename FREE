    })
end

local function dropdownRow(title, getOptions, cb)
    local opts = getOptions()
    local d = CurrentTab:Dropdown({
        Title = title,
        Values = opts,
        Value = (selected and table.find(opts, selected)) and selected or nil,
        Multi = false,
        AllowNone = true,
        Callback = function(opt)
            if not ready then return end
            if type(opt) == "table" then opt = opt.Title or opt[1] end
            if opt then cb(opt) end
        end,
    })
    return {
        refresh = function() pcall(function() d:Refresh(getOptions()) end) end,
        set = function(name) if name then pcall(function() d:Select(name) end) end end,
    }
end

