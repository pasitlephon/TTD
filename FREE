-- คืนฟังก์ชัน set(v) ที่ขยับสวิตช์เฉยๆ โดยไม่เรียก callback
local function toggleRow(title, subtitle, cb, init)
    local expected = nil
    local t = CurrentTab:Toggle({
        Title = title,
        Desc = subtitle,
        Value = init == true,
        Callback = function(v)
            if not ready then return end
            local e = expected
            expected = nil
            if e ~= nil and v == e then return end -- มาจากการตั้งค่าด้วยโค้ค ไม่ใช่การกดของผู้ใช้
            cb(v)
        end,
    })
    return function(v)
        expected = v
        pcall(function() t:Set(v) end)
    end
end

local function buttonRow(text, cb)
    local b = CurrentTab:Button({ Title = text, Callback = cb })
