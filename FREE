--// ================= Join Infinite =================
local infToken = 0
local INF_RETRY = 5 -- วินาที ระหว่างแต่ละรอบ

runInfinite = function()
    infToken += 1 -- ยกเลิกลูปเก่า กันรันซ้อน
    local my = infToken
    local attempt = 0
    while autoInfinite and alive() and infToken == my do
        if returnToHubShown() then
            setStatus("♾ Join Infinite", "ReturnToHub แสดงอยู่ รอก่อน", nil)
        else
            attempt += 1
            local ok, err = pcall(function()
                local hub = RS:FindFirstChild("HubRemotes")
                local create = hub and hub:FindFirstChild("CreateMatch")
                local start = hub and hub:FindFirstChild("StartMatch")
                if not (create and start) then error("ยังไม่พบ HubRemotes (CreateMatch/StartMatch)") end
                local res = create:InvokeServer(infStage, nil, true)
                print("[Macro] CreateMatch ->", typeof(res) == "table" and HttpService:JSONEncode(res) or tostring(res))
                task.wait(0.5)
                start:InvokeServer()
            end)
            if not (autoInfinite and alive() and infToken == my) then break end
            setStatus("♾ Join Infinite",
                string.format("รอบที่ %d: ด่าน %d %s", attempt, infStage, ok and "ส่งคำสั่งแล้ว" or ("ไม่สำเร็จ: " .. tostring(err))), nil)
        end
        local untilT = os.clock() + INF_RETRY
        while os.clock() < untilT and autoInfinite and alive() and infToken == my do
            task.wait(0.25)
        end
    end
end

if autoInfinite then
    task.spawn(function()
        task.wait(3)
        if alive() and autoInfinite then runInfinite() end
    end)
end

