--// ทำขั้นตอนหลังเจอ ReturnToHub: ส่ง next / again (ตามสวิตช์) แล้วกด Return (ถ้าเปิด)
--// เรียกซ้ำได้เรื่อยๆ ตราบที่ ReturnToHub ยังแสดงอยู่ (กันรันซ้อนด้วย returnBusy)
local returnBusy = false
local function returnActions()
    if returnBusy then return end
    if not (autoNext or autoAgain or autoReturn) then return end
    returnBusy = true
    task.spawn(function()
        pcall(function()
            local done = false
            if autoNext then
                done = callAct("next")
                notify(done and "ส่ง next สำเร็จ" or "ส่ง next ไม่สำเร็จ")
            end
            -- ถ้าเปิดทั้งสองอัน: ใช้ next ก่อน ถ้าไม่สำเร็จค่อยส่ง again
            if autoAgain and not done then
                local ok = callAct("again")
                notify(ok and "ส่ง again สำเร็จ" or "ส่ง again ไม่สำเร็จ")
            end
            -- Return: ถ้า next/again ยังไม่พา ReturnToHub หายไป ค่อยกด Enter ที่ปุ่ม
            if autoReturn and alive() then
                if autoNext or autoAgain then task.wait(1) end
                if autoReturn and alive() and isShown(getReturnToHub()) then runReturn() end
            end
        end)
        returnBusy = false
    end)
end

--// เจอ ReturnToHub ครั้งแรก: ทำขั้นตอนด้านบน และเริ่มมาโครใหม่ (ถ้าเปิด Play ไว้)
local function onReturnToHub()
    print("[Macro] พบ GUI ReturnToHub บนหน้าจอ")
    returnActions()
    task.spawn(restartMacro, "ReturnToHub")
end

local RETURN_RETRY = 3 -- ReturnToHub ยังไม่หาย: ทำขั้นตอนซ้ำทุกๆ กี่วินาที

task.spawn(function()
    local last = isShown(getReturnToHub())
    local lastRun = last and os.clock() or 0
    while alive() do
        task.wait(0.25)
        local now = isShown(getReturnToHub())
        if now and not last then
            lastRun = os.clock()
            onReturnToHub()
        elseif now and (os.clock() - lastRun) >= RETURN_RETRY then
            -- ReturnToHub ยังค้างอยู่ = รอบก่อนไม่สำเร็จ ลองใหม่เรื่อยๆ จนกว่าจะหาย
            lastRun = os.clock()
            print("[Macro] ReturnToHub ยังแสดงอยู่ ลองทำขั้นตอนซ้ำ")
            returnActions()
        end
        last = now
    end
end)

