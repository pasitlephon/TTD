local function savePath(name) return FOLDER .. "/" .. name .. ".json" end

local function saveMacro()
    if #recData == 0 then return notify("ยังไม่มีข้อมูลที่บันทึก") end
    local name = fileName:gsub("[^%w_%-]", "")
    if name == "" then return notify("ชื่อไฟล์ไม่ถูกต้อง") end
    table.sort(recData, function(x, y) return x.t < y.t end)
    writefile(savePath(name), HttpService:JSONEncode(recData))
    notify("เซฟแล้ว: " .. name .. " (" .. #recData .. " actions)")
end

local function loadMacro(name)
    local p = savePath(name)
    if not isfile(p) then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(p)) end)
    if not (ok and type(data) == "table") then return nil end
    -- ไฟล์มาโครเก่าที่เคยบันทึก start/next/again ไว้ ให้ตัดทิ้งตอนโหลด (ไม่เล่นซ้ำ)
    local clean = {}
    for _, a in ipairs(data) do
        if not (type(a) == "table" and type(a.args) == "table" and IGNORE_ACTIONS[a.args[1]]) then
            table.insert(clean, a)
        end
    end
    return clean
end

local function getFiles()
    local list = {}
    for _, path in ipairs(listfiles(FOLDER)) do
        local n = path:match("([^/\\]+)%.json$")
        if n and n:sub(1, 1) ~= "_" then table.insert(list, n) end
    end
    table.sort(list)
    return list
end

--// Auto Tower Placement: หาจุดบนเส้นทางมอนสเตอร์จาก workspace.CandyTD.Effects.RouteArrows
local function routeFolder()
    local c = workspace:FindFirstChild("CandyTD")
    local e = c and c:FindFirstChild("Effects")
    local r = e and e:FindFirstChild("RouteArrows")
    -- สำรอง: ถ้าโครงสร้างต่างจากที่คาด ให้หา RouteArrows ทั่ว workspace
    return r or workspace:FindFirstChild("RouteArrows", true)
end

local function routeArrows()
    local r = routeFolder()
    return r and r:GetChildren() or {}
end

local function instancePos(o)
    if not o then return nil end
    if o:IsA("BasePart") then return o.Position end
    if o:IsA("Model") then
        local ok, cf = pcall(function() return o:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    if o:IsA("Attachment") then return o.WorldPosition end
    if o:IsA("Vector3Value") then return o.Value end
    if o:IsA("CFrameValue") then return o.Value.Position end
    for _, d in ipairs(o:GetDescendants()) do
        if d:IsA("BasePart") then return d.Position end
        if d:IsA("Attachment") then return d.WorldPosition end
    end
    local attr = o:GetAttribute("Position")
    if typeof(attr) == "Vector3" then return attr end
    return nil
end

