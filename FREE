local function isShown(obj)
    if not obj then return false end
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("LayerCollector") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

--// ส่งคำสั่ง next / again ไปที่ Act แล้วเช็คผลตอบกลับ ok = true (ลองซ้ำได้ถึง 5 ครั้ง)
local function callAct(action)
    for try = 1, 5 do
        if not alive() then return false end
        local act = getAct()
        if act then
            local ok, res = pcall(function() return act:InvokeServer(action) end)
            if ok and type(res) == "table" and res.ok == true then
                print(string.format("[Macro] \"%s\" ok = true", action))
                return true
            end
            print(string.format("[Macro] \"%s\" ครั้งที่ %d ไม่สำเร็จ: %s", action, try,
                ok and (type(res) == "table" and tostring(res.err or res.error or res.reason or res.message or "ok = false") or tostring(res)) or tostring(res)))
        end
        task.wait(0.5)
    end
    return false
end

-- Lobby / Return: ยิง MatchRemotes.ReturnToHub:FireServer() ตรงๆ (ไม่ใช้โหมดคีย์บอร์ด/GUI)
local function fireReturnToHub()
    local mr = RS:FindFirstChild("MatchRemotes")
    local r = mr and mr:FindFirstChild("ReturnToHub")
    if not r then return false, "ไม่พบ MatchRemotes.ReturnToHub" end
    r:FireServer()
    return true, r:GetFullName()
end

runReturn = function()
