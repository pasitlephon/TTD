--// พยายาม Join 1 รอบ: คืน (กดแล้วไหม, ข้อความสถานะ)
local function tryJoinOnce()
    local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    local hubWindows = pg and pg:FindFirstChild("HubWindows")
    if not hubWindows then return false, "ยังไม่พบ HubWindows" end

    local challenges = hubWindows:FindFirstChild("Challenges")
    if not challenges then return false, "ยังไม่พบ Challenges" end

    local justOpened = false
    if not challenges.Visible then
        challenges.Visible = true
        justOpened = true
    end

    local pop = challenges:FindFirstChild("Pop")
    local panel = pop and pop:FindFirstChild("Panel")
    local panelFill = panel and panel:FindFirstChild("Fill")
    if not panelFill then return false, "Panel.Fill ยังโหลดไม่เสร็จ" end

    local c1 = isBonusClaimed(hubWindows, "Car1")
    local c2 = isBonusClaimed(hubWindows, "Car2")
    local c3 = isBonusClaimed(hubWindows, "Car3")

    -- ครบทั้ง 3 ด่าน = Car1 / ไม่งั้นเลือกด่านแรกที่ยังไม่ได้
    local pick = "Car1"
    if not (c1 and c2 and c3) then
        if not c1 then pick = "Car1"
        elseif not c2 then pick = "Car2"
        else pick = "Car3" end
    end

    local car = panelFill:FindFirstChild(pick)
    local carFill = car and car:FindFirstChild("Fill")
    local playBtn = carFill and carFill:FindFirstChild("Play")
    if not playBtn then return false, "ยังไม่พบปุ่ม Play ของ " .. pick end

    if justOpened then task.wait(0.5) end -- รอให้หน้าต่างแสดงก่อนกด

    print(string.format("[Macro] Join: BONUS CLAIMED -> Car1: %s, Car2: %s, Car3: %s",
        tostring(c1), tostring(c2), tostring(c3)))

    if selectAndPressPlay(playBtn) then
        return true, pick
    end
    return false, "กดปุ่ม Play ไม่สำเร็จ"
end

--// Join แบบวนซ้ำ: ทำต่อเรื่อยๆ จนกว่าจะปิดสวิตช์ (หรือเทเลพอร์ตออกจากฮับ)
local JOIN_RETRY = 5 -- วินาที ระหว่างแต่ละรอบ

local function runJoin()
    joinToken += 1 -- ยกเลิกลูปเก่า (ถ้ามี) กันรันซ้อนกัน
    local my = joinToken
    local attempt = 0
    local lastMsg

    while autoJoin and alive() and joinToken == my do
        if returnToHubShown() then
            lastMsg = "ReturnToHub แสดงอยู่ รอก่อน"
            setStatus("🚪 Join", lastMsg, nil)
        else
            attempt += 1
            local ok, pressed, info = pcall(tryJoinOnce)
            if not (autoJoin and alive() and joinToken == my) then break end

            if not ok then
                lastMsg = "error: " .. tostring(pressed)
                warn("[Macro] Join error: " .. tostring(pressed))
            elseif pressed then
                lastMsg = string.format("รอบที่ %d: เลือก %s แล้วกด Play (ลองซ้ำถ้ายังอยู่ที่เดิม)", attempt, tostring(info))
                notify("Join: เลือก " .. tostring(info))
            else
                lastMsg = string.format("รอบที่ %d: %s (ลองใหม่ใน %d วิ)", attempt, tostring(info), JOIN_RETRY)
                print("[Macro] Join: " .. lastMsg)
            end
            setStatus("🚪 Join", lastMsg, nil)
        end

        -- รอระหว่างรอบ แต่ตรวจสวิตช์ทุก 0.25 วิ เพื่อหยุดทันทีเมื่อปิด
        local untilT = os.clock() + JOIN_RETRY
        while os.clock() < untilT and autoJoin and alive() and joinToken == my do
            task.wait(0.25)
        end
    end
end

