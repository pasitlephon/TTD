local RESTART_DELAY = 1 -- เจอ GUI ReturnToHub แล้วรอกี่วินาทีก่อนเริ่มมาโครรอบใหม่
local restartToken = 0
restartMacro = function(reason)
    if recording then print("[Macro] ไม่เริ่มใหม่: กำลังอัดมาโครอยู่") return end
    if not (playEnabled or waitingRestart) then
        print("[Macro] ไม่เริ่มใหม่: ปุ่ม Play ถูกปิดเอง/ยังไม่เคยเปิด")
        return
    end

    restartToken += 1
    local my = restartToken

    -- หยุดรอบเก่า แล้วเปิดปุ่ม Play ให้เห็นว่าเปิดใหม่
    playToken += 1
    playing = false
    waitingRestart = false
    playEnabled = true
    saveSettings()
    if setPlayToggle then setPlayToggle(true) end -- ขยับสวิตช์เฉยๆ (ไม่เรียก callback)
    notify("พบ " .. tostring(reason) .. " → เปิด Play และรอ " .. RESTART_DELAY .. " วิ ก่อนเริ่มมาโคร")

    -- นับถอยหลังก่อนเริ่ม
    local untilT = os.clock() + RESTART_DELAY
    while os.clock() < untilT do
        if restartToken ~= my or not playEnabled or recording or not alive() then return end
        local left = untilT - os.clock()
        setStatus(
            "🔁 พบ " .. tostring(reason),
            string.format("เริ่มมาโครใหม่ในอีก %d วิ", math.ceil(left)),
            (RESTART_DELAY - left) / RESTART_DELAY
        )
        task.wait(0.1)
    end
    if restartToken ~= my or not playEnabled or recording then return end

    if not startPlay() then notify("เริ่มใหม่ไม่ได้: ไม่พบไฟล์มาโครที่เลือก") end
end

--// เช็ค slot: แก้ให้คืน table ชื่อยูนิตที่ equip อยู่ในเกมของคุณ
local function getEquippedUnits()
    return nil
end

local function checkSlots()
    local data = selected and loadMacro(selected)
    if not data then return notify("เลือกไฟล์มาโครก่อน") end
    local need, seen = {}, {}
    for _, a in ipairs(data) do
        if a.args[1] == "place" and not seen[a.args[2]] then
            seen[a.args[2]] = true
            table.insert(need, a.args[2])
        end
    end
    local equipped = getEquippedUnits()
    if not equipped then
        return notify("ยูนิตที่ต้องใช้: " .. table.concat(need, ", "))
    end
    local have, missing = {}, {}
    for _, u in ipairs(equipped) do have[u] = true end
    for _, u in ipairs(need) do if not have[u] then table.insert(missing, u) end end
    notify(#missing == 0 and "Slot ตรงกับมาโครครบ ✅" or ("ขาด: " .. table.concat(missing, ", ")))
end

