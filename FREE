local function fmtNum(n)
    return type(n) == "number" and string.format("%.1f", n) or tostring(n)
end

-- คำสั่งที่อ้างอิงยูนิตด้วยไอดีในอาร์กิวเมนต์ที่ 2 (ต้องแมปไอดีเก่า -> ใหม่ตอนเล่น)
local UNIT_ID_ACTIONS = {upgrade = true, sell = true, target = true}

local function describe(args)
    local act = args[1]
    if act == "place" then
        return string.format("วางยูนิต %s ที่ (%s, %s)", tostring(args[2]), fmtNum(args[3]), fmtNum(args[4]))
    elseif act == "upgrade" then
        return string.format("อัปเกรดยูนิต #%s", tostring(args[2]))
    elseif act == "sell" then
        return string.format("ขายยูนิต #%s", tostring(args[2]))
    elseif act == "target" then
        return string.format("ตั้งรูปแบบโจมตียูนิต #%s เป็น \"%s\"", tostring(args[2]), tostring(args[3]))
    end
    local parts = {}
    for i, v in ipairs(args) do parts[i] = tostring(v) end
    return table.concat(parts, ", ")
end

