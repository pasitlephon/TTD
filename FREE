--// ================= Sell All =================
local function sellOne(id)
    local act = getAct()
    if not act then return false end
    local ok, res = pcall(function() return act:InvokeServer("sell", id) end)
    return ok and type(res) == "table" and res.ok == true
end

local function sellAll()
    -- ขายไอดีที่รู้จักก่อน แล้วกวาดไอดีใกล้เคียงเผื่อมียูนิตที่ไม่ได้ถูกจำไว้
    local maxId = 0
    for id in pairs(placedIds) do
        if type(id) == "number" then maxId = math.max(maxId, id) end
    end
    local sold = 0
    for id in pairs(table.clone(placedIds)) do
        if sellOne(id) then sold += 1 end
        placedIds[id] = nil
    end
    for id = 1, math.max(maxId + 5, 30) do
        if not alive() then break end
        if sellOne(id) then sold += 1 end
    end
    return sold
end

