local function getCurrentWave()
    local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    local candy = pg and pg:FindFirstChild("CandyTD")
    local hud = candy and candy:FindFirstChild("HUD")
    local wave = hud and hud:FindFirstChild("Wave")
    local body = wave and wave:FindFirstChild("Body")
    local plaque = body and body:FindFirstChild("Plaque")
    local fill = plaque and plaque:FindFirstChild("Fill")
    local value = fill and fill:FindFirstChild("Value")
    local shadow = value and value:FindFirstChild("Shadow")
    if not (shadow and (shadow:IsA("TextLabel") or shadow:IsA("TextButton"))) then return nil end
    local txt = shadow.ContentText ~= "" and shadow.ContentText or shadow.Text
    local n = string.match(string.upper(txt), "WAVE%s*(%d+)")
    return n and tonumber(n) or nil
end

