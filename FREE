--// เปิด HubWindows.Challenges แล้วเลือกด่าน Car1/Car2/Car3 ที่ยังไม่มี BONUS CLAIMED แล้วกด Play
local joinToken = 0

local function isBonusClaimed(hubWindows, carName)
    local pop = hubWindows:FindFirstChild("Challenges") and hubWindows.Challenges:FindFirstChild("Pop")
    local panel = pop and pop:FindFirstChild("Panel")
    local fillRoot = panel and panel:FindFirstChild("Fill")
    local car = fillRoot and fillRoot:FindFirstChild(carName)
    local carFill = car and car:FindFirstChild("Fill")
    if not carFill then return false end

    -- FirstWin.Caption.Shadow
    local firstWin = carFill:FindFirstChild("FirstWin")
    if firstWin and firstWin.Visible then
        local caption = firstWin:FindFirstChild("Caption")
        local shadow = caption and caption:FindFirstChild("Shadow")
        if shadow and (shadow:IsA("TextLabel") or shadow:IsA("TextButton")) then
            local textValue = shadow.ContentText ~= "" and shadow.ContentText or shadow.Text
            if string.find(string.upper(textValue), "BONUS CLAIMED") then
                return true
            end
        end
    end

    -- กรณีมี Label BONUS CLAIMED ตรงๆ ใน Car.Fill
    local directBonus = carFill:FindFirstChild("BonusClaimed") or carFill:FindFirstChild("Claimed")
    if directBonus and directBonus.Visible then
        return true
    end

    return false
end

local function selectAndPressPlay(playButton)
    if not playButton then
        notify("Join: ไม่พบปุ่ม Play")
        return false
